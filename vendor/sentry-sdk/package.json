{
  "name": "@kallon/sentry-sdk",
  "version": "0.2.0",
  "description": "Typed TypeScript client and data-contract library for the Sentry v2 coordination service (viewer-facing API, session-protocol v1 + the §A inventory contract).",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && tsc -p tsconfig.types.json && node scripts/postbuild.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build",
    "test": "node --test test/smoke.test.mjs",
    "pretest": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "keywords": [
    "sentry",
    "kallon",
    "webrtc",
    "whep",
    "ptz",
    "coordination"
  ]
}
